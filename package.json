{
  "name": "tauri-plugin-fontgres-api",
  "version": "0.1.0",
  "author": "Seferino Fernandez",
  "description": "JavaScript bindings for tauri-plugin-fontgres: list the system's fonts and answer CSS-style font queries in Tauri v2.",
  "keywords": [
    "tauri",
    "tauri-plugin",
    "font",
    "fonts",
    "system-fonts",
    "fontgres"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seferino-fernandez/tauri-plugin-fontgres.git"
  },
  "homepage": "https://github.com/seferino-fernandez/tauri-plugin-fontgres#readme",
  "bugs": "https://github.com/seferino-fernandez/tauri-plugin-fontgres/issues",
  "license": "MIT",
  "type": "module",
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.cjs",
  "module": "./dist-js/index.js",
  "exports": {
    "types": "./dist-js/index.d.ts",
    "import": "./dist-js/index.js",
    "require": "./dist-js/index.cjs"
  },
  "files": [
    "dist-js",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "prepublishOnly": "pnpm build",
    "pretest": "pnpm build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.1",
    "rollup": "^4.68.8",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.23.0"
}
